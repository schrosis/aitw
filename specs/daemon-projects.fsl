fsl 5
// Requirements for the projects that the resident process serves: how a command registers a
// project, how the resident process keeps and restores them, and how it stops their Workers.
// Source: docs/reference/commands/daemon.md ("プロジェクトの登録", "ugoke daemon stop")
//
// MODEL-PRJ-001: one project is modeled. Whether it has .ugoke and whether its Worker can start
//                are given when a command registers it, and again when the resident process
//                restarts.
// MODEL-PRJ-003: the command that asks ends with 1 when the project is refused, as run-command.fsl
//                and attach-cancel.fsl end a command whose server cannot be prepared.
// MODEL-PRJ-004: the resident process stops in the same way when it receives SIGTERM or SIGINT,
//                so stop also stands for those signals.
// MODEL-PRJ-002: whether a script of the project is running is given when the resident process
//                is asked to stop.
requirements DaemonProjects {
  actor User, Daemon

  entity Project {
    hasUgoke: Bool = false
    workerStarts: Bool = false
    listed: Bool = false
    serving: Bool = false
    scriptRunning: Bool = false
    lifecycle Unknown -> Asked -> Registered -> Stopping -> Stopped
    lifecycle Asked -> Refused
    lifecycle Registered -> Asked
    lifecycle Stopped -> Asked
    lifecycle Stopping -> Stopping
    lifecycle Asked -> Dropped
  }

  event ask = User asks Project with hasUgoke, workerStarts (Unknown -> Asked)
    covers REQ-PRJ-001 "常駐プロセスのサーバーを使うコマンドは、プロジェクトを常駐プロセスに登録する"
  event askAgain = User asksAgain Project with hasUgoke, workerStarts (Registered -> Asked)
    covers REQ-PRJ-001 "常駐プロセスのサーバーを使うコマンドは、プロジェクトを常駐プロセスに登録する"
  event refuse = Daemon refuses Project (Asked -> Refused)
  event register = Daemon registers Project with serving (Asked -> Registered)
    set listed = true
  event stop = User stops Project with scriptRunning (Registered -> Stopping)
    covers REQ-PRJ-004 "常駐プロセスは、止めるときに、実行中のスクリプトが終わるのを待つ"
  event finishScript = Daemon finishesScript Project (Stopping -> Stopping)
    set scriptRunning = false
    covers REQ-PRJ-004 "常駐プロセスは、止めるときに、実行中のスクリプトが終わるのを待つ"
  event halt = Daemon halts Project (Stopping -> Stopped)
    set serving = false
  event restore = User restores Project with hasUgoke, workerStarts (Stopped -> Asked)
  event drop = Daemon drops Project (Asked -> Dropped)
    set listed = false

  rule REQ-PRJ-002 ".ugoke のないプロジェクトは登録せず、登録を頼んだコマンドは 1 で終わる。Worker が起動できなくても登録は残し、次の登録で起動し直す" {
    allow Daemon refuses Project only when not hasUgoke and not listed
    allow Daemon registers Project only when hasUgoke and input serving == workerStarts
    RegisteredIsListed: always Project in Registered has listed
    ServingNeedsUgoke: always Project in Registered has (not serving or hasUgoke)
  }
  rule REQ-PRJ-003 "常駐プロセスを起動し直すと、覚えていたプロジェクトを戻す。.ugoke がなくなったプロジェクトは外す" {
    allow User restores Project only when listed
    allow Daemon drops Project only when listed and not hasUgoke
    DroppedIsNotListed: always Project in Dropped has not listed
  }
  rule REQ-PRJ-004 "常駐プロセスは、止めるときに、実行中のスクリプトが終わるのを待つ" {
    allow Daemon halts Project only when not scriptRunning
    allow Daemon finishesScript Project only when scriptRunning
    StoppedRunsNoScript: always Project in Stopped has not scriptRunning
  }

  scenario AC-PRJ-001 "プロジェクトを登録して、Worker を動かす" {
    User asks p1 with hasUgoke true, workerStarts true
    Daemon registers p1 with serving true
    then p1 is Registered
  }
  scenario AC-PRJ-002 ".ugoke のないプロジェクトは、登録しない" {
    User asks p1 with hasUgoke false, workerStarts false
    Daemon refuses p1
    then p1 is Refused
  }
  scenario AC-PRJ-003 "Worker が起動できなくても登録は残し、次の登録で起動し直す" {
    User asks p1 with hasUgoke true, workerStarts false
    Daemon registers p1 with serving false
    User asksAgain p1 with hasUgoke true, workerStarts true
    Daemon registers p1 with serving true
    then p1 is Registered
  }
  scenario AC-PRJ-004 "止めるときは、実行中のスクリプトが終わるのを待つ" {
    User asks p1 with hasUgoke true, workerStarts true
    Daemon registers p1 with serving true
    User stops p1 with scriptRunning true
    Daemon finishesScript p1
    Daemon halts p1
    then p1 is Stopped
  }
  scenario AC-PRJ-005 "起動し直したときに、.ugoke がなくなったプロジェクトは外す" {
    User asks p1 with hasUgoke true, workerStarts true
    Daemon registers p1 with serving true
    User stops p1 with scriptRunning false
    Daemon halts p1
    User restores p1 with hasUgoke false, workerStarts false
    Daemon drops p1
    then p1 is Dropped
  }
  scenario AC-PRJ-006 "起動し直すと、覚えていたプロジェクトを戻す" {
    User asks p1 with hasUgoke true, workerStarts true
    Daemon registers p1 with serving true
    User stops p1 with scriptRunning false
    Daemon halts p1
    User restores p1 with hasUgoke true, workerStarts true
    Daemon registers p1 with serving true
    then p1 is Registered
  }

  forbidden FB-PRJ-001 ".ugoke のないプロジェクトを、登録しない" {
    User asks p1 with hasUgoke false, workerStarts true
    Daemon registers p1 with serving true
    then rejected
  }
  forbidden FB-PRJ-002 "Worker が起動できないのに、動いていることにしない" {
    User asks p1 with hasUgoke true, workerStarts false
    Daemon registers p1 with serving true
    then rejected
  }
  forbidden FB-PRJ-003 "実行中のスクリプトを待たずに、止めない" {
    User asks p1 with hasUgoke true, workerStarts true
    Daemon registers p1 with serving true
    User stops p1 with scriptRunning true
    Daemon halts p1
    then rejected
  }
  forbidden FB-PRJ-004 ".ugoke があるプロジェクトを、外さない" {
    User asks p1 with hasUgoke true, workerStarts true
    Daemon registers p1 with serving true
    User stops p1 with scriptRunning false
    Daemon halts p1
    User restores p1 with hasUgoke true, workerStarts true
    Daemon drops p1
    then rejected
  }
  forbidden FB-PRJ-005 ".ugoke があるプロジェクトを、拒まない" {
    User asks p1 with hasUgoke true, workerStarts false
    Daemon refuses p1
    then rejected
  }
  forbidden FB-PRJ-006 "Worker が起動できるのに、動かさずに登録しない" {
    User asks p1 with hasUgoke true, workerStarts true
    Daemon registers p1 with serving false
    then rejected
  }
}
verify {
  instances Project = 1
}
