{
  "name": "aitw",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "aitw": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json .",
    "test": "vitest run --root ../.. --passWithNoTests packages/cli/",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@aitw/adapter-ai-claude-code": "workspace:*",
    "@aitw/adapter-event-log-file": "workspace:*",
    "@aitw/adapter-script-local": "workspace:*",
    "@aitw/adapter-wait-terminal": "workspace:*",
    "@aitw/core": "workspace:*",
    "@aitw/definition": "workspace:*",
    "@aitw/dotenv": "workspace:*",
    "@aitw/engine": "workspace:*",
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@temporalio/testing": "catalog:",
    "@types/node": "catalog:"
  },
  "engines": {
    "node": ">=26.13.0"
  }
}
