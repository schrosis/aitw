fsl 5
// Requirements for running an accepted workflow definition.
// Source: docs/reference/workflow-definition.md ("実行", "ステップのつながり").
//
// MODEL-RUN-001: a run is described by the steps it has left before end, which the run of an
//                accepted definition knows when it starts. workflow-transitions.fsl and the
//                checks that validate-command.fsl names decide which definitions are accepted,
//                and workflow-pipeline.fsl checks that their runs have one to three steps before
//                end.
// MODEL-RUN-002: whether a script or an AI step succeeds is not decided by ugoke, so a failure is
//                a fault event.
requirements WorkflowRun {
  number Count
  actor Ugoke, Script, User

  entity Run {
    remaining: Count = 0
    executed: Count = 0
    lifecycle Waiting -> Running -> Completed
    lifecycle Running -> Failed
    lifecycle Running -> Cancelled
  }

  event start = Ugoke starts Run with remaining (Waiting -> Running)
    covers REQ-TRN-008 "ワークフローは start のステップから始まる"
  event advance = Ugoke advances Run in Running
    set remaining = remaining - 1, executed = executed + 1
  event complete = Ugoke completes Run (Running -> Completed)
    set executed = executed + 1
  fault event fail = Script fails Run (Running -> Failed)
    set executed = executed + 1
    covers REQ-RUN-001 "ステップが失敗すると、ワークフローはそれ以降のステップを実行せずに失敗する"
  event cancel = User cancels Run (Running -> Cancelled)
    set executed = executed + 1
    covers REQ-RUN-006 "取り消すと、ワークフローはそれ以降のステップを実行しない"

  rule REQ-RUN-005 "受け付けた定義の実行は、end までのステップを 1 つ以上持つ" {
    allow Ugoke starts Run only when input remaining >= 1 and input remaining <= 3
  }
  rule REQ-TRN-006 "ステップが成功すると、その next に進む。分岐があれば、条件が成り立つ最初の分岐の行き先に進む" {
    allow Ugoke advances Run only when remaining >= 2
  }
  rule REQ-TRN-007 "行き先が end のステップが成功すると、ワークフローが終わる" {
    allow Ugoke completes Run only when remaining == 1
  }
  rule REQ-RUN-002 "失敗したステップは、やり直さない" {
    RunsEachStepOnce: always Run in Failed, Completed, Cancelled has executed <= 3
  }
  rule REQ-RUN-003 "失敗しなければ、ワークフローは end で終わる" {
    NoStepAfterEnd: always Run in Running has remaining >= 1
    CompletedRunsEveryStep: always Run in Completed has remaining == 1
  }

  scenario AC-RUN-001 "ステップが全部成功すると、end で終わる" {
    Ugoke starts r1 with remaining 2
    Ugoke advances r1
    Ugoke completes r1
    then r1 is Completed
  }
  scenario AC-RUN-002 "途中のステップが失敗すると、ワークフローは失敗する" {
    Ugoke starts r1 with remaining 2
    Script fails r1
    then r1 is Failed
  }
  scenario AC-RUN-003 "3 つのステップを 1 度ずつ実行して、end で終わる" {
    Ugoke starts r1 with remaining 3
    Ugoke advances r1
    Ugoke advances r1
    Ugoke completes r1
    then stage(r1) == Completed and r1.executed == 3
  }
  scenario AC-RUN-004 "途中のステップが失敗すると、そのステップまでを実行する" {
    Ugoke starts r1 with remaining 3
    Ugoke advances r1
    Script fails r1
    then stage(r1) == Failed and r1.executed == 2
  }
  scenario AC-RUN-005 "取り消すと、そのときのステップまでを実行して止まる" {
    Ugoke starts r1 with remaining 2
    User cancels r1
    then stage(r1) == Cancelled and r1.executed == 1
  }

  forbidden FB-RUN-001 "失敗したあとは、次のステップに進まない" {
    Ugoke starts r1 with remaining 2
    Script fails r1
    Ugoke advances r1
    then rejected
  }
  forbidden FB-RUN-002 "失敗したあとは、終わりにしない" {
    Ugoke starts r1 with remaining 1
    Script fails r1
    Ugoke completes r1
    then rejected
  }
  forbidden FB-RUN-003 "end の前のステップでは終わらない" {
    Ugoke starts r1 with remaining 2
    Ugoke completes r1
    then rejected
  }
  forbidden FB-RUN-004 "最後のステップのあとには進まない" {
    Ugoke starts r1 with remaining 1
    Ugoke advances r1
    then rejected
  }
  forbidden FB-RUN-005 "end までのステップのない実行は始めない" {
    Ugoke starts r1 with remaining 0
    then rejected
  }
  forbidden FB-RUN-006 "取り消したあとは、次のステップに進まない" {
    Ugoke starts r1 with remaining 2
    User cancels r1
    Ugoke advances r1
    then rejected
  }
}
verify {
  instances Run = 1
  values Count = 0..4
}
