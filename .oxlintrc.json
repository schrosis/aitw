{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": ["**/dist/**", "**/coverage/**"],
  "rules": {
    "func-style": ["error", "expression"],
    "import/first": "error"
  },
  "plugins": ["typescript", "unicorn", "oxc", "import"]
}
