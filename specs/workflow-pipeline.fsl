fsl 5
// ugoke run from the name of a workflow to the end of its run: resolveWorkflow finds the
// definition file, parseDefinition checks its shape, the transition check of compileDefinition
// accepts or rejects it, ugoke run starts an accepted one and follows it, and the interpreter of
// the engine runs it. The shape is a necessary condition of acceptance, and only an accepted
// definition runs.
//
// A command that could not finish, or a run that could not end, would stop here with nothing left
// to do, which the deadlock check reports.
//
// MODEL-PIP-001: parse-definition.fsl checks every kind of shape problem on its own. Here one kind
//                stands for all of them, and the steps arrive only after the aliases are checked,
//                so that the components do not interleave without need.
// MODEL-PIP-003: resolve-workflow.fsl checks every layout of directories and files on its own.
//                Here .ugoke is in the directory where the command runs and the name has a .yaml
//                file, and only whether the name is valid varies.
// MODEL-PIP-005: follow-run.fsl checks every combination of server options on its own. Here only
//                --dev, --dev-db and whether the resident process runs vary.
// MODEL-PIP-004: a step that exits with a nonzero status stands for every failure of a step. A
//                step that passes its timeout fails the same way in interpret-workflow.fsl, so
//                run.timeOut is internal and never synchronized here.
compose WorkflowPipeline {
  use ResolveWorkflow as find from "resolve-workflow.fsl"
  use ParseDefinition as parse from "parse-definition.fsl"
  use ValidateTransitions as links from "validate-transitions.fsl"
  use InterpretWorkflow as run from "interpret-workflow.fsl"
  use FollowRun as cmd from "follow-run.fsl"

  state {
    // ghost: ugoke run detached while the run had two or more steps before end
    detachedEarly: Bool
  }
  init {
    detachedEarly = false
  }

  // Ctrl+C while the resident process runs the steps: ugoke run detaches, and the run goes on.
  @requirement("REQ-CMD-005", "常駐プロセスで実行しているときは、すぐに切り離れ、ワークフローは続く")
  fair action detach(d: parse.Definition) = cmd.interruptDaemon(d) {
    detachedEarly = run.remaining[d] >= 2
  }

  @requirement("REQ-PRJ-004", "ワークフローは、名前で指定する")
  fair action issue(d: parse.Definition, n: Bool) =
    find.run(d, false, false, false, true, n, true, false) {
  }

  // A step starts only while the interpreter runs the definition.
  @requirement("MODEL-FOL-001", "ステップの実行が始まり、終わる")
  fair action stepStarts(d: parse.Definition) = cmd.stepStarts(d) {
    requires run.phase[d] == Executing
  }

  // The definition file that resolveWorkflow found is read and parsed.
  @requirement("REQ-PRJ-005", "名前に合う .yaml か .yml の定義を使う")
  fair action read(d: parse.Definition, broken: Bool) =
    find.fileOk(d) || parse.write(d, broken, false, false, false, false, false, false, false, false) {
  }

  @requirement("REQ-DEF-011", "ワークフローは、YAML のファイルに定義する")
  fair action fill(d: parse.Definition, p: Bool, n: links.Node) =
    links.fill(d, p, n) || run.fill(d, p, n) {
    requires parse.phase[d] == AliasesChecked
  }

  @requirement("MODEL-VAL-001", "形のチェックを通った定義から、中間表現を作る")
  fair action build(d: parse.Definition, s: links.Node) =
    parse.schemaOk(d) || links.build(d, s) {
  }

  // A definition that fails a check is not run, and ugoke run exits with 1.
  @requirement("REQ-CMD-002", "定義に問題があるときは、エラーを表示し、何も実行しない")
  fair action syntaxFails(d: parse.Definition, dv: Bool, db: Bool, dr: Bool) =
    parse.syntaxFails(d) || cmd.run(d, false, false, dv, dv and db, false, dr, true) {
  }

  @requirement("REQ-CMD-002", "定義に問題があるときは、エラーを表示し、何も実行しない")
  fair action aliasesFail(d: parse.Definition, dv: Bool, db: Bool, dr: Bool) =
    parse.aliasesFail(d) || cmd.run(d, false, false, dv, dv and db, false, dr, true) {
  }

  @requirement("REQ-CMD-002", "定義に問題があるときは、エラーを表示し、何も実行しない")
  fair action schemaFails(d: parse.Definition, dv: Bool, db: Bool, dr: Bool) =
    parse.schemaFails(d) || cmd.run(d, false, false, dv, dv and db, false, dr, true) {
  }

  @requirement("REQ-CMD-002", "定義に問題があるときは、エラーを表示し、何も実行しない")
  fair action rejectTransitions(d: parse.Definition, dv: Bool, db: Bool, dr: Bool) =
    links.validateFails(d) || cmd.run(d, false, false, dv, dv and db, false, dr, true) {
  }

  // Only an accepted definition is handed to the interpreter, and ugoke run follows it.
  @requirement("REQ-TRN-005", "つながりの決まりを満たす定義は受け付ける")
  fair action launch(d: parse.Definition, dv: Bool, db: Bool, dr: Bool) =
    links.validateOk(d) || run.aim(d, links.start[d]) || cmd.run(d, true, false, dv, dv and db, false, dr, true) {
  }

  @requirement("REQ-TRN-008", "ワークフローは start のステップから始まる")
  fair action start(d: parse.Definition) = cmd.begin(d) || run.load(d) {
  }

  // A step ends while ugoke run follows the run, or after it detached.
  @requirement("REQ-TRN-006", "ステップが成功すると、その next に進む")
  fair action advance(d: parse.Definition) = cmd.stepEnds(d) || run.succeed(d) {
  }

  @requirement("REQ-TRN-006", "ステップが成功すると、その next に進む")
  fair action advanceDetached(d: parse.Definition) = run.succeed(d) {
    requires cmd.phase[d] == Left
  }

  @requirement("REQ-TRN-007", "next に end を書いたステップが成功すると、ワークフローが終わる")
  fair action complete(d: parse.Definition) = cmd.stepEnds(d) || run.succeedLast(d) {
  }

  @requirement("REQ-TRN-007", "next に end を書いたステップが成功すると、ワークフローが終わる")
  fair action completeDetached(d: parse.Definition) = run.succeedLast(d) {
    requires cmd.phase[d] == Left
  }

  @requirement("REQ-CMD-003", "終了ステータスは、完了で 0、失敗か定義の問題で 1、切り離しで 3、取り消しか 2 度目の Ctrl+C で 130")
  fair action finish(d: parse.Definition) = cmd.finish(d) {
    requires run.phase[d] == Succeeded
  }

  @requirement("REQ-RUN-001", "ステップが失敗すると、ワークフローはそれ以降のステップを実行せずに失敗する")
  fair action stepFails(d: parse.Definition) = cmd.breaks(d) || run.exitNonzero(d) {
  }

  @requirement("REQ-RUN-001", "ステップが失敗すると、ワークフローはそれ以降のステップを実行せずに失敗する")
  fair action stepFailsWhileStopping(d: parse.Definition) = cmd.stepEnds(d) || run.exitNonzero(d) {
    requires cmd.phase[d] == Stopping
  }

  @requirement("REQ-RUN-001", "ステップが失敗すると、ワークフローはそれ以降のステップを実行せずに失敗する")
  fair action stepFailsDetached(d: parse.Definition) = run.exitNonzero(d) {
    requires cmd.phase[d] == Left
  }

  // Ctrl+C on a development server that keeps no runs cancels the run.
  @requirement("REQ-CMD-007", "実行の記録を残さないサーバーでは、ワークフローを取り消す")
  fair action cancel(d: parse.Definition) = cmd.interruptEphemeral(d) || run.withdraw(d) {
  }

  // The second Ctrl+C exits ugoke run with its Worker, and the running step fails.
  @requirement("REQ-CMD-009", "待っているあいだにもう 1 度 Ctrl+C を押すと、すぐに終了し、実行中のステップは失敗する")
  fair action quit(d: parse.Definition) = cmd.interruptAgain(d) || run.loseWorker(d) {
  }

  internal find.run
  internal find.fileOk
  internal parse.write
  internal parse.schemaOk
  internal parse.syntaxFails
  internal parse.aliasesFail
  internal parse.schemaFails
  internal links.fill
  internal links.build
  internal links.validateOk
  internal links.validateFails
  internal run.fill
  internal run.aim
  internal run.load
  internal run.succeed
  internal run.succeedLast
  internal run.exitNonzero
  internal run.timeOut
  internal run.withdraw
  internal run.loseWorker
  internal cmd.run
  internal cmd.stepStarts
  internal cmd.begin
  internal cmd.stepEnds
  internal cmd.finish
  internal cmd.breaks
  internal cmd.interruptEphemeral
  internal cmd.interruptAgain
  internal cmd.interruptDaemon

  @requirement("REQ-PRJ-005", "名前に合う .yaml か .yml の定義を使う")
  invariant OnlyFoundFilesAreRead {
    forall d: parse.Definition { parse.phase[d] != Unread => find.phase[d] == FileFound }
  }

  @requirement("MODEL-CMP-001", "形のチェックを通らない定義は、つながりのチェックに進まない")
  invariant ShapeComesFirst {
    forall d: parse.Definition { links.phase[d] != Waiting => parse.phase[d] == Parsed }
  }

  @requirement("REQ-CMD-002", "定義に問題があるときは、エラーを表示し、何も実行しない")
  invariant OnlyAcceptedDefinitionsRun {
    forall d: parse.Definition {
      run.phase[d] != Idle and run.phase[d] != Aimed => links.phase[d] == Valid
    }
  }

  @requirement("REQ-TRN-004", "受け付けた定義は、実行すると必ず終わる。失敗しなければ end で終わる")
  invariant InterpreterNeverRefusesAccepted {
    forall d: parse.Definition { run.phase[d] != Refused }
  }

  @requirement("REQ-TRN-004", "受け付けた定義は、実行すると必ず終わる。失敗しなければ end で終わる")
  invariant RunIsShort {
    forall d: parse.Definition { run.executed[d] <= 3 }
  }

  @requirement("REQ-TRN-002", "どのステップも、start からたどれなければならない")
  invariant EveryStepRuns {
    forall d: parse.Definition {
      run.phase[d] == Succeeded => (
        (run.v0[d] or not links.p0[d]) and (run.v1[d] or not links.p1[d])
          and (run.v2[d] or not links.p2[d]))
    }
  }

  @requirement("REQ-CMD-008", "実行の記録を残すサーバーでは、Ctrl+C でワークフローを取り消さない")
  invariant DurableRunsAreNotCancelled {
    forall d: parse.Definition { cmd.durable[d] => run.phase[d] != Withdrawn }
  }

  @requirement("REQ-CMD-003", "終了ステータスは、完了で 0、失敗か定義の問題で 1、切り離しで 3、取り消しか 2 度目の Ctrl+C で 130")
  invariant ExitMatchesRun {
    forall d: parse.Definition {
      (cmd.phase[d] == Finished => run.phase[d] == Succeeded)
        and (cmd.phase[d] == Broke => run.phase[d] == Aborted)
        and (cmd.phase[d] == Withdrew => run.phase[d] == Withdrawn)
    }
  }

  @requirement("REQ-CMD-005", "常駐プロセスで実行しているときは、すぐに切り離れ、ワークフローは続く")
  reachable DetachedRunReachesEnd {
    exists d: parse.Definition { detachedEarly and run.phase[d] == Succeeded }
  }

  // A command ends when it cannot find the workflow, when it rejects the definition, or when it
  // has stopped following a run that has ended. compose has no terminal block, so this action
  // marks those states as ends: any other state where nothing can happen is a deadlock.
  @requirement("MODEL-CMP-002", "ワークフローが見つからないか、定義が拒否されるか、実行が終わると、コマンドは終わる")
  action rest(d: parse.Definition) {
    requires find.phase[d] == NameRejected or find.phase[d] == NoRoot
      or find.phase[d] == FileMissing or find.phase[d] == FileDoubled
      or cmd.phase[d] == Rejected or cmd.phase[d] == Unserved
      or ((cmd.phase[d] == Finished or cmd.phase[d] == Broke or cmd.phase[d] == Left
          or cmd.phase[d] == Withdrew or cmd.phase[d] == Quit)
        and (run.phase[d] == Succeeded or run.phase[d] == Aborted or run.phase[d] == Withdrawn))
  }
}
