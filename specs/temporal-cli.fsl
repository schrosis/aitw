fsl 5
// Requirements for the Temporal CLI that starts a temporary Temporal Server: the one that the user
// gives, or the release that ugoke pins and downloads to its cache.
// Source: docs/reference/commands/run.md ("Temporal CLI")
//
// MODEL-TCL-001: whether the user gives a Temporal CLI, whether ugoke has a release for the
//                platform, whether the cache directory is safe, whether the release is in the
//                cache, and whether a download matches its checksum are given when the server is
//                asked for. The commands that ask for it (ugoke run --dev, ugoke daemon start) are
//                not modeled.
// MODEL-TCL-002: the Temporal CLI only is modeled, not the server that it starts.
requirements TemporalCli {
  enum Source { NoSource, GivenBin, PinnedRelease }
  enum Reason { NoReason, UnsafeCache, Unsupported, Mismatch }
  actor User, Ugoke

  entity Fetch {
    binGiven: Bool = false
    supported: Bool = false
    cacheSafe: Bool = false
    cached: Bool = false
    checksumOk: Bool = false
    downloaded: Bool = false
    stored: Bool = false
    source: Source = NoSource
    reason: Reason = NoReason
    lifecycle Unasked -> Asked -> Ready
    lifecycle Asked -> Downloading -> Ready
    lifecycle Asked -> Failed
    lifecycle Downloading -> Failed
  }

  def needsPinned(b: Bool) = not b
  def refusalOf(safe: Bool) = if safe then Unsupported else UnsafeCache

  event ask = User asks Fetch with binGiven, supported, cacheSafe, cached, checksumOk (Unasked -> Asked)
    covers REQ-TCL-001 "一時的な Temporal Server を起動する Temporal CLI を決める"
  event useGiven = Ugoke uses Fetch (Asked -> Ready)
    set source = GivenBin
  event useCached = Ugoke reuses Fetch (Asked -> Ready)
    set source = PinnedRelease
  event refuse = Ugoke refuses Fetch with reason (Asked -> Failed)
  event download = Ugoke downloads Fetch (Asked -> Downloading)
    set downloaded = true
  event store = Ugoke stores Fetch (Downloading -> Ready)
    set stored = true, source = PinnedRelease
  event discard = Ugoke discards Fetch (Downloading -> Failed)
    set reason = Mismatch

  rule REQ-TCL-002 "--temporal-bin を指定したときは、その Temporal CLI を使い、何もダウンロードしない" {
    allow Ugoke uses Fetch only when binGiven
    GivenDownloadsNothing: always Fetch in Ready has (not binGiven or (source == GivenBin and not downloaded))
    SourceFollowsBin: always Fetch in Ready has (binGiven == (source == GivenBin) and source != NoSource)
  }
  rule REQ-TCL-003 "指定しないときは、ugoke が決めた版を使う。キャッシュにあれば、ダウンロードしない" {
    allow Ugoke reuses Fetch only when needsPinned(binGiven) and supported and cacheSafe and cached
    allow Ugoke downloads Fetch only when needsPinned(binGiven) and supported and cacheSafe and not cached
    CachedDownloadsNothing: always Fetch in Ready has (not cached or binGiven or not downloaded)
    MissingIsDownloaded: always Fetch in Ready has (source != PinnedRelease or cached or (downloaded and stored))
  }
  rule REQ-TCL-004 "対応しない環境と、ほかのユーザーが使えるキャッシュのディレクトリでは、ダウンロードせずに失敗する" {
    allow Ugoke refuses Fetch only when needsPinned(binGiven) and (not supported or not cacheSafe) and input reason == refusalOf(cacheSafe)
    PinnedNeedsSafePlace: always Fetch in Ready has (source != PinnedRelease or (supported and cacheSafe))
  }
  rule REQ-TCL-005 "ダウンロードしたファイルは、チェックサムを確かめる。合わなければ、使わず、キャッシュにも残さずに失敗する" {
    allow Ugoke stores Fetch only when checksumOk
    allow Ugoke discards Fetch only when not checksumOk
    MismatchIsNotKept: always Fetch in Failed has not stored
    FailureHasReason: always Fetch in Failed has (reason != NoReason and (downloaded == (reason == Mismatch)))
    StoredMatches: always Fetch in Ready has (not stored or checksumOk)
  }

  scenario AC-TCL-001 "--temporal-bin を指定すると、その Temporal CLI を使う" {
    User asks f1 with binGiven true, supported false, cacheSafe false, cached false, checksumOk false
    Ugoke uses f1
    then f1 is Ready
  }
  scenario AC-TCL-002 "初めてのときは、ダウンロードして使う" {
    User asks f1 with binGiven false, supported true, cacheSafe true, cached false, checksumOk true
    Ugoke downloads f1
    Ugoke stores f1
    then f1 is Ready
  }
  scenario AC-TCL-003 "キャッシュにあれば、それを使う" {
    User asks f1 with binGiven false, supported true, cacheSafe true, cached true, checksumOk false
    Ugoke reuses f1
    then f1 is Ready
  }
  scenario AC-TCL-004 "チェックサムが合わなければ、失敗する" {
    User asks f1 with binGiven false, supported true, cacheSafe true, cached false, checksumOk false
    Ugoke downloads f1
    Ugoke discards f1
    then f1 is Failed
  }
  scenario AC-TCL-005 "対応しない環境では、失敗する" {
    User asks f1 with binGiven false, supported false, cacheSafe true, cached false, checksumOk true
    Ugoke refuses f1 with reason Unsupported
    then f1 is Failed
  }
  scenario AC-TCL-006 "ほかのユーザーが使えるキャッシュのディレクトリでは、失敗する" {
    User asks f1 with binGiven false, supported true, cacheSafe false, cached true, checksumOk true
    Ugoke refuses f1 with reason UnsafeCache
    then f1 is Failed
  }

  forbidden FB-TCL-001 "--temporal-bin を指定したのに、ダウンロードしない" {
    User asks f1 with binGiven true, supported true, cacheSafe true, cached false, checksumOk true
    Ugoke downloads f1
    then rejected
  }
  forbidden FB-TCL-002 "キャッシュにあるのに、ダウンロードしない" {
    User asks f1 with binGiven false, supported true, cacheSafe true, cached true, checksumOk true
    Ugoke downloads f1
    then rejected
  }
  forbidden FB-TCL-003 "チェックサムが合わないものを、使わない" {
    User asks f1 with binGiven false, supported true, cacheSafe true, cached false, checksumOk false
    Ugoke downloads f1
    Ugoke stores f1
    then rejected
  }
  forbidden FB-TCL-004 "対応しない環境で、ダウンロードしない" {
    User asks f1 with binGiven false, supported false, cacheSafe true, cached false, checksumOk true
    Ugoke downloads f1
    then rejected
  }
  forbidden FB-TCL-005 "安全でないキャッシュのものを、使わない" {
    User asks f1 with binGiven false, supported true, cacheSafe false, cached true, checksumOk true
    Ugoke reuses f1
    then rejected
  }
  forbidden FB-TCL-006 "安全でないキャッシュに、ダウンロードしない" {
    User asks f1 with binGiven false, supported true, cacheSafe false, cached false, checksumOk true
    Ugoke downloads f1
    then rejected
  }
  forbidden FB-TCL-007 "チェックサムが合うものを、捨てない" {
    User asks f1 with binGiven false, supported true, cacheSafe true, cached false, checksumOk true
    Ugoke downloads f1
    Ugoke discards f1
    then rejected
  }
  forbidden FB-TCL-008 "--temporal-bin を指定したのに、キャッシュのものを使わない" {
    User asks f1 with binGiven true, supported true, cacheSafe true, cached true, checksumOk true
    Ugoke reuses f1
    then rejected
  }
  forbidden FB-TCL-009 "--temporal-bin を指定したのに、失敗しない" {
    User asks f1 with binGiven true, supported false, cacheSafe false, cached false, checksumOk false
    Ugoke refuses f1 with reason Unsupported
    then rejected
  }
  forbidden FB-TCL-010 "指定していない Temporal CLI を、使わない" {
    User asks f1 with binGiven false, supported true, cacheSafe true, cached true, checksumOk true
    Ugoke uses f1
    then rejected
  }
  forbidden FB-TCL-011 "使える環境とキャッシュで、失敗しない" {
    User asks f1 with binGiven false, supported true, cacheSafe true, cached false, checksumOk true
    Ugoke refuses f1 with reason Unsupported
    then rejected
  }
  forbidden FB-TCL-012 "安全でないキャッシュの失敗を、対応しない環境の失敗にしない" {
    User asks f1 with binGiven false, supported false, cacheSafe false, cached false, checksumOk true
    Ugoke refuses f1 with reason Unsupported
    then rejected
  }
  forbidden FB-TCL-013 "対応しない環境の失敗を、安全でないキャッシュの失敗にしない" {
    User asks f1 with binGiven false, supported false, cacheSafe true, cached false, checksumOk true
    Ugoke refuses f1 with reason UnsafeCache
    then rejected
  }
  forbidden FB-TCL-014 "ダウンロードする前に、キャッシュに残さない" {
    User asks f1 with binGiven false, supported true, cacheSafe true, cached false, checksumOk true
    Ugoke stores f1
    then rejected
  }
  forbidden FB-TCL-015 "求められる前に、ダウンロードしない" {
    Ugoke downloads f1
    then rejected
  }
  forbidden FB-TCL-016 "求められたあとに、もう 1 度求めない" {
    User asks f1 with binGiven true, supported true, cacheSafe true, cached true, checksumOk true
    User asks f1 with binGiven true, supported true, cacheSafe true, cached true, checksumOk true
    then rejected
  }
  forbidden FB-TCL-017 "求められる前に、指定された Temporal CLI を使わない" {
    Ugoke uses f1
    then rejected
  }
  forbidden FB-TCL-018 "求められる前に、キャッシュのものを使わない" {
    Ugoke reuses f1
    then rejected
  }
  forbidden FB-TCL-019 "求められる前に、失敗しない" {
    Ugoke refuses f1 with reason Unsupported
    then rejected
  }
  forbidden FB-TCL-020 "ダウンロードする前に、捨てない" {
    User asks f1 with binGiven false, supported true, cacheSafe true, cached false, checksumOk false
    Ugoke discards f1
    then rejected
  }
  forbidden FB-TCL-021 "決めたあとに、ダウンロードしない" {
    User asks f1 with binGiven false, supported true, cacheSafe true, cached true, checksumOk true
    Ugoke reuses f1
    Ugoke downloads f1
    then rejected
  }
}
verify {
  instances Fetch = 1
}
