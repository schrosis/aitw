{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["*.ts", "packages/*/vite.config.ts", "packages/*/src/**/*.test.ts"]
}
