fsl 5
// refine: validate-transitions.fsl workflow-transitions.fsl
//
// The transition check and the run keep the transition requirements.
refinement ValidateTransitionsRefinesWorkflowTransitions {
  impl ValidateTransitions
  abs WorkflowTransitions

  map definition_stage[d: Definition] =
    if phase[d] == Waiting then Draft
    else if phase[d] == Built then Written
    else if phase[d] == Valid then Accepted
    else if phase[d] == Invalid then Rejected
    else if phase[d] == Going then Running
    else Finished
  map definition_p0[d: Definition] = p0[d]
  map definition_p1[d: Definition] = p1[d]
  map definition_p2[d: Definition] = p2[d]
  map definition_n0[d: Definition] = n0[d]
  map definition_n1[d: Definition] = n1[d]
  map definition_n2[d: Definition] = n2[d]
  map definition_start[d: Definition] = start[d]
  map definition_current[d: Definition] = current[d]
  map definition_taken[d: Definition] = taken[d]
  map definition_v0[d: Definition] = v0[d]
  map definition_v1[d: Definition] = v1[d]
  map definition_v2[d: Definition] = v2[d]
  map definition_filled[d: Definition] = filled[d]

  action fill(d, p, n) -> fill(d, p, n)
  action build(d, s) -> write(d, s)
  action validateOk(d) -> accept(d)
  action validateFails(d) -> reject(d)
  action begin(d) -> begin(d)
  action step(d) -> step(d)
  action finish(d) -> finish(d)
}
