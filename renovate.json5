{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":semanticCommits"],
  internalChecksFilter: "strict",
  // Keep this value in sync with minimumReleaseAge in pnpm-workspace.yaml.
  minimumReleaseAge: "3 days",
  customManagers: [
    {
      // The checksums are not updated by Renovate. CI fails until they are updated with
      // node scripts/update-temporal-cli.ts <version>, and mise.lock with mise lock.
      customType: "regex",
      managerFilePatterns: ["/^packages/cli/src/temporal-cli/manifest\\.ts$/"],
      matchStrings: ['version: "(?<currentValue>[0-9.]+)"'],
      datasourceTemplate: "github-releases",
      depNameTemplate: "temporalio/cli",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
  ],
  packageRules: [
    {
      // mise.toml and package.json must move to the same toolchain versions.
      groupName: "toolchain",
      matchDepNames: ["node", "pnpm"],
    },
    {
      // @commander-js/extra-typings requires the same minor version of commander.
      groupName: "commander",
      matchDepNames: ["commander", "@commander-js/extra-typings"],
    },
    {
      // mise.toml installs the Temporal CLI for tests, and tests require the version that the
      // manifest pins for the development server.
      groupName: "temporal-cli",
      matchDepNames: ["temporalio/cli", "aqua:temporalio/cli"],
    },
    {
      // Temporal SDK packages must share the same version.
      groupName: "temporal",
      matchPackageNames: ["@temporalio/*"],
    },
    {
      // The prompts depend on @inquirer/core. Updating them together keeps one version of it and
      // of its dependencies in the lockfile.
      groupName: "inquirer",
      matchPackageNames: ["@inquirer/*"],
    },
  ],
}
