fsl 5
// Design of the interpreter of the engine (packages/engine/src/workflows/index.ts), which runs an
// intermediate representation:
//
// - it validates the representation again, and refuses one that is not valid (InvalidIntermediate)
// - it runs the steps from start along next, one Activity at a time
// - a step whose script exits with a nonzero status or passes its timeout fails, and the
//   Activity is not retried (maximumAttempts: 1), so the run fails there
//
// It refines the run requirements of workflow-run.fsl.
spec InterpretWorkflow {
  entity Definition
  const END = 3
  type Node = 0..3
  type Count = 0..4
  enum InterpretPhase { Idle, Aimed, Executing, Succeeded, Aborted, Withdrawn, Refused }
  enum Cause { NoCause, NonzeroExit, TimedOut, WorkerLost }

  state {
    phase: Map<Definition, InterpretPhase>,
    p0: Map<Definition, Bool>,
    p1: Map<Definition, Bool>,
    p2: Map<Definition, Bool>,
    n0: Map<Definition, Node>,
    n1: Map<Definition, Node>,
    n2: Map<Definition, Node>,
    start: Map<Definition, Node>,
    filled: Map<Definition, Count>,
    valid: Map<Definition, Bool>,
    remaining: Map<Definition, Count>,
    current: Map<Definition, Node>,
    executed: Map<Definition, Count>,
    cause: Map<Definition, Cause>,
    v0: Map<Definition, Bool>,
    v1: Map<Definition, Bool>,
    v2: Map<Definition, Bool>
  }

  init {
    forall d: Definition {
      phase[d] = Idle
      p0[d] = false
      p1[d] = false
      p2[d] = false
      n0[d] = 3
      n1[d] = 3
      n2[d] = 3
      start[d] = 0
      filled[d] = 0
      valid[d] = false
      remaining[d] = 0
      current[d] = 0
      executed[d] = 0
      cause[d] = NoCause
      v0[d] = false
      v1[d] = false
      v2[d] = false
    }
  }

  // These definitions are copies: workflow-transitions.fsl, validate-transitions.fsl and
  // interpret-workflow.fsl each have them, because FSL cannot share a def across files. Keep the
  // three the same.
  def has(p0: Bool, p1: Bool, p2: Bool, x: Node) = (x == 0 and p0) or (x == 1 and p1) or (x == 2 and p2)

  def to(n0: Node, n1: Node, n2: Node, x: Node) =
    if x == 0 then n0 else if x == 1 then n1 else if x == 2 then n2 else END

  // A node that next may name: end, or a step of the definition.
  def known(p0: Bool, p1: Bool, p2: Bool, x: Node) = x == END or has(p0, p1, p2, x)

  // A step whose next is end or an unknown step ends a path. An unknown step is reported on its
  // own, so it does not count as a path that never ends (validateTermination).
  def endsPath(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node, x: Node) =
    to(n0, n1, n2, x) == END or not known(p0, p1, p2, to(n0, n1, n2, x))

  // Steps from which following next ends a path within three moves.
  def canEnd(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node, x: Node) =
    has(p0, p1, p2, x) and (
      endsPath(p0, p1, p2, n0, n1, n2, x)
        or (has(p0, p1, p2, to(n0, n1, n2, x))
          and endsPath(p0, p1, p2, n0, n1, n2, to(n0, n1, n2, x)))
        or (has(p0, p1, p2, to(n0, n1, n2, x))
          and has(p0, p1, p2, to(n0, n1, n2, to(n0, n1, n2, x)))
          and endsPath(p0, p1, p2, n0, n1, n2, to(n0, n1, n2, to(n0, n1, n2, x))))
    )

  // Steps that following next from start visits; three steps need at most two moves.
  def reachable(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node, s: Node, x: Node) =
    x == s
      or (has(p0, p1, p2, s) and to(n0, n1, n2, s) == x)
      or (has(p0, p1, p2, s) and has(p0, p1, p2, to(n0, n1, n2, s))
        and to(n0, n1, n2, to(n0, n1, n2, s)) == x)

  def targetsKnown(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node, s: Node) =
    has(p0, p1, p2, s) and (forall x: Node {
      has(p0, p1, p2, x) => known(p0, p1, p2, to(n0, n1, n2, x))
    })

  def allReachable(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node, s: Node) =
    forall x: Node { has(p0, p1, p2, x) => reachable(p0, p1, p2, n0, n1, n2, s, x) }

  def allCanEnd(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node) =
    forall x: Node { has(p0, p1, p2, x) => canEnd(p0, p1, p2, n0, n1, n2, x) }


  // Steps that following next from s takes to reach end, for a valid representation.
  def distance(n0: Node, n1: Node, n2: Node, s: Node) =
    if to(n0, n1, n2, s) == END then 1
    else if to(n0, n1, n2, to(n0, n1, n2, s)) == END then 2
    else 3

  // The steps of the representation arrive one by one (MODEL-TRN-004 of workflow-transitions.fsl).
  @requirement("MODEL-INT-001", "実行する中間表現を受け取る")
  action fill(d: Definition, p: Bool, n: Node) {
    requires phase[d] == Idle
    requires filled[d] < 3
    p0[d] = if filled[d] == 0 then p else p0[d]
    p1[d] = if filled[d] == 1 then p else p1[d]
    p2[d] = if filled[d] == 2 then p else p2[d]
    n0[d] = if filled[d] == 0 then n else n0[d]
    n1[d] = if filled[d] == 1 then n else n1[d]
    n2[d] = if filled[d] == 2 then n else n2[d]
    filled[d] = filled[d] + 1
  }

  // The interpreter validates the representation again before it runs anything.
  @requirement("MODEL-INT-001", "実行する中間表現を受け取る")
  action aim(d: Definition, s: Node) {
    requires phase[d] == Idle
    requires filled[d] == 3
    phase[d] = Aimed
    start[d] = s
    valid[d] = targetsKnown(p0[d], p1[d], p2[d], n0[d], n1[d], n2[d], s)
      and allReachable(p0[d], p1[d], p2[d], n0[d], n1[d], n2[d], s)
      and allCanEnd(p0[d], p1[d], p2[d], n0[d], n1[d], n2[d])
    remaining[d] = distance(n0[d], n1[d], n2[d], s)
  }

  @requirement("REQ-TRN-008", "ワークフローは start のステップから始まる")
  action load(d: Definition) {
    requires phase[d] == Aimed
    requires valid[d]
    phase[d] = Executing
    current[d] = start[d]
    v0[d] = start[d] == 0
    v1[d] = start[d] == 1
    v2[d] = start[d] == 2
  }

  @requirement("MODEL-INT-002", "正しくない中間表現は実行しない（InvalidIntermediate）")
  action refuse(d: Definition) {
    requires phase[d] == Aimed
    requires not valid[d]
    phase[d] = Refused
  }

  @requirement("REQ-TRN-006", "ステップが成功すると、その next に進む")
  action succeed(d: Definition) {
    requires phase[d] == Executing
    let t = to(n0[d], n1[d], n2[d], current[d])
    requires t != END
    requires remaining[d] >= 2
    current[d] = t
    remaining[d] = remaining[d] - 1
    executed[d] = executed[d] + 1
    v0[d] = v0[d] or t == 0
    v1[d] = v1[d] or t == 1
    v2[d] = v2[d] or t == 2
  }

  @requirement("REQ-TRN-007", "next に end を書いたステップが成功すると、ワークフローが終わる")
  action succeedLast(d: Definition) {
    requires phase[d] == Executing
    requires to(n0[d], n1[d], n2[d], current[d]) == END
    phase[d] = Succeeded
    executed[d] = executed[d] + 1
  }

  @requirement("REQ-RUN-001", "ステップが失敗すると、ワークフローはそれ以降のステップを実行せずに失敗する")
  action exitNonzero(d: Definition) {
    requires phase[d] == Executing
    phase[d] = Aborted
    cause[d] = NonzeroExit
    executed[d] = executed[d] + 1
  }

  @requirement("REQ-RUN-001", "ステップが失敗すると、ワークフローはそれ以降のステップを実行せずに失敗する")
  action timeOut(d: Definition) {
    requires phase[d] == Executing
    phase[d] = Aborted
    cause[d] = TimedOut
    executed[d] = executed[d] + 1
  }

  // The Worker that runs the step exits before the step ends, for example at the second Ctrl+C of
  // ugoke run. The step fails, and the run cannot be continued.
  @requirement("REQ-RUN-001", "ステップが失敗すると、ワークフローはそれ以降のステップを実行せずに失敗する")
  action loseWorker(d: Definition) {
    requires phase[d] == Executing
    phase[d] = Aborted
    cause[d] = WorkerLost
    executed[d] = executed[d] + 1
  }

  // The run is cancelled, for example by ugoke cancel.
  @requirement("REQ-RUN-006", "取り消すと、ワークフローはそれ以降のステップを実行しない")
  action withdraw(d: Definition) {
    requires phase[d] == Executing
    phase[d] = Withdrawn
    executed[d] = executed[d] + 1
  }

  @requirement("MODEL-INT-003", "受け取った中間表現の、end までのステップの数を覚える")
  invariant RemainingMatchesNext {
    forall d: Definition {
      phase[d] == Executing => (
        (remaining[d] == 1) == (to(n0[d], n1[d], n2[d], current[d]) == END))
    }
  }

  @requirement("MODEL-INT-004", "失敗には、0 以外の終了か時間切れの原因がある")
  invariant FailureHasCause {
    forall d: Definition { phase[d] == Aborted => cause[d] != NoCause }
  }

  // A failed run does nothing more: no step runs again after it fails.
  @requirement("REQ-RUN-002", "失敗したステップは、やり直さない")
  trans FailedRunStaysFailed {
    forall d: Definition {
      (old(phase[d]) == Aborted => (phase[d] == Aborted and executed[d] == old(executed[d])))
        and (old(phase[d]) == Withdrawn => (phase[d] == Withdrawn and executed[d] == old(executed[d])))
    }
  }

  terminal {
    forall d: Definition {
      phase[d] == Succeeded or phase[d] == Aborted or phase[d] == Withdrawn or phase[d] == Refused
    }
  }
}
verify {
  instances Definition = 1
}
